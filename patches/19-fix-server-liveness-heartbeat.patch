+    The wait is taken a second at a time, beating the heartbeat between
+    slices, so that a wedged request child - or a frozen server - can
+    be told from one merely waiting for a request.

+    Each slice ends the moment child_pid exits, not when the second is
+    up: the next request child is forked only after this returns, so a
+    fixed sleep would add up to a second to every request. A pidfd
+    becomes readable when its process exits; where one cannot be had,
+    the slice is a plain sleep and the wait merely coarser.

+    '''
+    wake = None
+    try:
+        try:
+            wake = select.poll()
+            pidfd = os.pidfd_open(child_pid)
+        except (AttributeError, OSError):
+            # No pidfd_open (Python < 3.9, a kernel < 5.3, a seccomp
+            # filter), or the child is already gone - which the next
+            # waitpid() reports.
+            wake = pidfd = None
+        else:
+            wake.register(pidfd, select.POLLIN)
+        while True:
+            (pid, status) = os.waitpid(-1, os.WNOHANG)
+            if pid == 0:
+                _beat(child_pid)
+                if wake is not None:
+                    wake.poll(_HEARTBEAT_SLICE_SECONDS * 1000)
+                else:
+                    time.sleep(_HEARTBEAT_SLICE_SECONDS)
+                continue
+            if pid == child_pid:
+                return status
+            logging.debug('Reaped orphaned process %d (status %d)', pid,
+                          status)
+    finally:
+        if wake is not None:
+            os.close(pidfd)
+

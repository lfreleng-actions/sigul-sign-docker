+# The server's liveness heartbeat. The supervising parent rewrites it
+# once a second while it runs, and the chart's liveness probe reads its
+# age. Only the parent's own loop beats - no thread: it forks for every
+# request, and a fork with a second thread running could leave the
+# child holding a lock nobody will release.
+#
+# A heartbeat that only proves the parent runs would miss the wedges
+# this server has actually had, so it is withheld while:
+#
+# - the request child has been stopped; a frozen container stops the
+#   parent too, and goes stale regardless;
+# - a request child has held no connection to the bridge for longer
+#   than _DISCONNECTED_SECONDS. That is the double-TLS teardown wedge
+#   patch 06 fixes and the chart's connection check was the backstop
+#   for: the child blocked, the parent waiting on it, nothing connected
+#   and nothing reconnecting. That check restarted such a server within
+#   two minutes, and so must this: the heartbeat then takes another
+#   slice to be withheld, thirty seconds to go stale, and three liveness
+#   failures ten seconds apart, so the bound leaves them their share of
+#   the two minutes. It is still far above any healthy gap: a teardown
+#   takes seconds under patch 06's linger, and a bridge that refuses
+#   the connection sends the parent to its reconnection sleep.
+#
+# A child waiting for a request is connected and asleep, and a long
+# wait for one is normal; a parent sleeping between reconnections while
+# the bridge is down is doing what it should. Neither is withheld.
+_HEARTBEAT_SLICE_SECONDS = 1
+_DISCONNECTED_SECONDS = 50
+_heartbeat_path = None
+_bridge_port = None
+_disconnected_since = None
+
+
+def _connected_to_bridge():
+    '''Whether this host holds an ESTABLISHED TCP connection to the bridge.
+
+    Read from /proc/net/tcp{,6}, the state the chart's probes read. On
+    any failure to read, say connected: an unreadable table is not
+    evidence of a wedge.
+
+    '''
+    if _bridge_port is None:
+        return True
+    want = ':%04X' % _bridge_port
+    read_any = False
+    for table in ('/proc/net/tcp', '/proc/net/tcp6'):
+        try:
+            with open(table) as f:
+                next(f, None)
+                for line in f:
+                    fields = line.split()
+                    # rem_address ends in the port; state 01 is ESTABLISHED.
+                    if len(fields) > 3 and fields[2].endswith(want) \
+                            and fields[3] == '01':
+                        return True
+            read_any = True
+        except (IOError, OSError):
+            continue
+    # A table that was read and holds no such connection is an answer;
+    # only when neither could be read is there none.
+    return not read_any
+
+
+def _child_stopped(pid):
+    '''Whether process pid is stopped (SIGSTOP, or frozen under a tracer).'''
+    try:
+        with open('/proc/%d/stat' % pid) as f:
+            # The state follows the command, which is in parentheses and
+            # may itself contain spaces or parentheses.
+            state = f.read().rsplit(')', 1)[1].split()[0]
+    except (IOError, OSError, IndexError):
+        return False
+    return state in ('T', 't')
+
+
+def _beat(child_pid=None):
+    '''Refresh the heartbeat, unless the request child looks wedged.
+
+    child_pid is the request child being waited for, or None while no
+    child runs - between reconnection attempts, say.
+
+    '''
+    global _disconnected_since
+    if _heartbeat_path is None:
+        return
+    if child_pid is None:
+        _disconnected_since = None
+    else:
+        if _child_stopped(child_pid):
+            return
+        if _connected_to_bridge():
+            _disconnected_since = None
+        else:
+            now = time.monotonic()
+            if _disconnected_since is None:
+                _disconnected_since = now
+            if now - _disconnected_since > _DISCONNECTED_SECONDS:
+                return
+    try:
+        with open(_heartbeat_path, 'w') as f:
+            f.write('{0:.0f}\n'.format(time.time()))
+    except (IOError, OSError) as e:
+        # Better a stale heartbeat, and a restart, than a crashed
+        # supervisor and an unexplained one.
+        logging.warning('Cannot write heartbeat %s: %s', _heartbeat_path, e)


+def _sleep_beating(seconds):
+    '''time.sleep(seconds), beating the heartbeat throughout.'''
+    deadline = time.monotonic() + seconds
+    while True:
+        _beat()
+        remaining = deadline - time.monotonic()
+        if remaining <= 0:
+            return
+        time.sleep(min(remaining, _HEARTBEAT_SLICE_SECONDS))
+
+

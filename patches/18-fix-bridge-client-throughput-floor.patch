+    def __init__(self, socket, idle_timeout=None, min_rate=None,
+                 rate_grace=None):
         '''Wrap socket.

         idle_timeout, in seconds, bounds every individual receive and
         send; on expiry NSPR raises NSPRError with PR_IO_TIMEOUT_ERROR.
         None means block indefinitely, as before.

+        min_rate, in bytes per second, is a floor on the peer's
+        throughput, measured over the time spent waiting on the peer:
+        inside this buffer's own receives and sends, never while the
+        caller is busy elsewhere - waiting on another peer, or working.
+        It is judged over the most recent rate_grace seconds of that
+        waiting, once there have been that many: a peer that completed
+        fewer than min_rate * rate_grace bytes within them raises
+        SlowPeerError. A rolling window, not a running average, so that
+        a fast start cannot buy a slow finish - a 64 MiB burst would
+        otherwise cover hours of trickle - and bytes leave it a window
+        after they arrived, however long the waits around them. The
+        idle deadline bounds a silent peer; this bounds one that
+        trickles, which the idle deadline never sheds. None means no
+        floor, as before.
+
         '''
         self.__socket = socket
+        self.__min_rate = min_rate
+        if min_rate is not None and not (rate_grace and rate_grace > 0):
+            # A floor with no window would never be enforced.
+            raise ValueError('min_rate needs a positive rate_grace')
+        self.__rate_window = rate_grace or 0
+        # Bytes moved, by when each transfer completed on the clock of
+        # time spent waiting on the peer: [slice number, bytes] for
+        # slices a sixtieth of the window long, oldest first, trimmed to
+        # those overlapping the most recent window. Keyed by where a
+        # transfer ends, not merged into whichever entry is open, so a
+        # long wait never carries older bytes along with it; and at most
+        # sixty-one entries however finely the peer chops its data.
+        self.__bucket_seconds = self.__rate_window / 60.0
+        self.__transfers = collections.deque()
+        self.__waited = 0.0
+        self.__moved = 0

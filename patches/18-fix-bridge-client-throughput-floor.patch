+    def __timed(self, operation, size_of):
+        '''Run operation(), charging its duration to the peer.
+
+        size_of(result) is the number of bytes it moved. The floor is
+        checked only once those are counted, so a transfer that just
+        completed is never judged by its wait alone.
+
+        '''
+        if self.__min_rate is None:
+            # No floor: nothing to measure, and nothing kept - the
+            # server's buffer lives as long as its connection.
+            return operation()
+        started = time.monotonic()
+        try:
+            result = operation()
+        except BaseException:
+            # Failed, so nothing moved; its wait still counts, but the
+            # error is what the caller needs to see.
+            self.__charge(time.monotonic() - started, 0)
+            raise
+        self.__charge(time.monotonic() - started, size_of(result))
+        self.__check_rate()
+        return result
+
+    def __charge(self, waited, moved):
+        '''Record one transfer, which ended after waiting `waited`.'''
+        self.__waited += waited
+        if moved:
+            slot = int(self.__waited // self.__bucket_seconds)
+            if self.__transfers and self.__transfers[-1][0] == slot:
+                self.__transfers[-1][1] += moved
+            else:
+                self.__transfers.append([slot, moved])
+            self.__moved += moved
+        # Keep only slices that overlap the most recent window.
+        oldest = int((self.__waited - self.__rate_window)
+                     // self.__bucket_seconds)
+        while self.__transfers and self.__transfers[0][0] < oldest:
+            self.__moved -= self.__transfers.popleft()[1]
+
+    def __check_rate(self):
+        '''Raise SlowPeerError if the peer is below its throughput floor.'''
+        if self.__min_rate is None or self.__waited <= self.__rate_window:
+            return
+        # The bytes completed within the last window of waiting, over
+        # that window. A slice straddling its start counts whole, which
+        # errs by at most a sixtieth of a window in the peer's favour.
+        rate = self.__moved / self.__rate_window
+        if rate < self.__min_rate:
+            raise SlowPeerError(
+                'Peer moved %d bytes in the last %g s of waiting on it '
+                '(%.0f B/s, floor %d B/s)' % (self.__moved,
+                                              self.__rate_window, rate,
+                                              self.__min_rate))

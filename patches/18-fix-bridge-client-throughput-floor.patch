@@ -199,6 +199,28 @@
 # signing operations stream data or finish in seconds.
 _REQUEST_IDLE_SECONDS = 120

+# The idle deadline sheds a client that stops; these shed one that
+# trickles. The bridge serves one request at a time, so a client moving
+# a few bytes a second holds signing for everyone for as long as its
+# payload takes - hours for a large one, forever at a byte a minute.
+# Measured only over time spent waiting on the client itself: never
+# while the bridge waits on the server, which is where signing, GPG and
+# Koji time goes, so no slow server-side operation can trip it. The
+# floor is a sixteenth of the slowest link the soak throttles clients
+# to, and far below any real CI network; the grace lets a small request,
+# or a slow start, through untouched.
+_CLIENT_MIN_BYTES_PER_SECOND = 4 * 1024
+_CLIENT_RATE_GRACE_SECONDS = 60
+
+# The inner stream bypasses the outer buffers, and with them the floor:
+# it is relayed on the raw sockets. It carries only the inner TLS
+# handshake and a few small fields - the client reads its passphrases
+# before connecting, and the server closes the stream before it signs
+# anything - so it ends in well under a second. Bounded as a whole, by
+# as long as one silence may last, so that a client trickling through
+# it cannot hold the only slot either.
+_INNER_PHASE_SECONDS = _REQUEST_IDLE_SECONDS
+
 # How often the bridge's liveness heartbeat is published, and the
 # longest any wait that would otherwise block indefinitely may last
 # before the main loop comes round again. The liveness probe reads the

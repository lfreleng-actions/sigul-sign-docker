#
# Time each request from its arrival. The request child's one-hour
# alarm was armed at fork, before it had a request, so a request that
# arrived late in an idle child's hour got only what was left of it -
# on a quiet server one lasting d seconds was cut off with probability
# of about d/3600 - and the kill was silent: the SystemExit it raised
# was swallowed and the child reported success. The alarm is now armed
# again when a request arrives, and a timeout during one is logged and
# reported to the parent as _CHILD_TIMEOUT (#48). See patches/README.md.
#
--- a/src/server.py
+++ b/src/server.py
@@ -116,7 +116,9 @@
 MAX_FAST_RECONNECTIONS = 5
 FAST_RECONNECTION_SECONDS = 5
 SLOW_RECONNECTION_SECONDS = 60
-# How long to wait for the request handler before killing it
+# How long a request child may wait for a request, and then how long it
+# may spend on one, before it is killed. The first bounds an idle child,
+# which is then replaced; the second is timed from the request's arrival.
 CHILD_TIMEOUT_SECS = 60 * 60

 # Infrastructure
@@ -339,6 +341,7 @@
